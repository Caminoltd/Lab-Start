  "notes": {
    "default": [
      "Ignore any lab steps that use Hyper-V Manager. All the VMs you need are already running.",
      "Logins and IP addresses are on the 3rd page of every lab in your lab guide, and in tab 3.",
      "Save your lab at the end of each day. Saving suspends the VMs and stops the countdown clock until you Launch (resume) the lab again.",
      "For the full lab notes with page references, and the lab topology, click the course page button above."
    ],
    "CCSE": [
      "Ignore any lab steps that use Hyper-V Manager. All the VMs used in Labs 1 to 5 are already running when the lab launches.",
      "Logins and IP addresses are on the 3rd page of every lab in your lab guide, and in tab 3. SmartConsole uses cpadmin.",
      "Lab 1: no Jumbo Hotfix is needed. Ignore the references to JHFA 33.",
      "Lab 1: A-SMS-02 is already running. Its Gaia Portal is https://10.1.1.111",
      "Save your lab at the end of each day. Saving suspends the VMs and stops the countdown clock until you Launch (resume) the lab again.",
      "For the full CCSE lab notes with page references, and the lab topology, click the course page button above."
    ]
  },
