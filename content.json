  "checklist": [
    {
      "text": "Choose your course (top right)",
      "detail": "Lab Start then shows the logins, documents and notes for your course."
    },
    {
      "text": "Set keyboard and timezone (tab 1, Localise)",
      "detail": "Choose your country and click Apply. The Windows VMs, including A-GUI, restart about a minute later. Lab Start opens again by itself when you log back in."
    },
    {
      "text": "Wait for all the VMs to restart (3 to 5 minutes)",
      "detail": "Log back in to A-GUI when its login screen returns. The Gaia VMs restart too."
    },
    {
      "text": "Check that the Localise tab says Done",
      "detail": "If it does not, click Check status. If it says Failed, tell your trainer."
    },
    {
      "text": "Note the logins and IP addresses (tab 3)",
      "detail": "Double-click any value to copy it. They are also on the 3rd page of every lab in your lab guide."
    },
    {
      "text": "Look at your course documents (tab 4)",
      "detail": "Lab credentials, command lists and URL lists for your course."
    },
    {
      "text": "Read the lab notes (tab 5)",
      "detail": "Corrections and tips, including lab steps to skip."
    },
    {
      "text": "Start Lab 1A",
      "detail": ""
    }
  ],
